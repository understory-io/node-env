{
  "name": "@riddance/env",
  "version": "2.0.0",
  "type": "module",
  "keywords": [
    "riddance",
    "environment",
    "devenv",
    "opinionated"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "^22",
    "cspell-lib": "10.4.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "devDependencies": {},
  "scripts": {
    "prepare": "tsc -p ./tsconfig.json && node ./bin/prepare.js",
    "start": "npm run prepare && node ./bin/install.js && node ./bin/watch.js",
    "prepack": "npm run prepare && node ./bin/build.js",
    "prepublishOnly": "tsc && node ./bin/prepublish.js",
    "postpublish": "node ./bin/sync.js",
    "postinstall": "npm run prepare && node ./bin/install.js",
    "postversion": "node ./bin/update.js",
    "lint": "eslint"
  },
  "files": [
    "template/**",
    "*.ts",
    "lib/*.ts",
    "bin/*.ts",
    "bin/lib/*.ts",
    "eslint.config.js",
    ".prettierrc.cjs",
    "tsconfig.json",
    ".vscode/*.json"
  ],
  "bin": {
    "riddance-watch": "./bin/watch.js",
    "riddance-build": "./bin/build.js",
    "riddance-prepublish": "./bin/prepublish.js",
    "riddance-sync": "./bin/sync.js"
  }
}
